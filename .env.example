DATABASE_URL=postgres://eventform:eventform@localhost:5432/eventform
DATABASE_URL_API=postgres://app_api:app_api_dev@localhost:5432/eventform
DATABASE_URL_WORKER=postgres://app_worker:app_worker_dev@localhost:5432/eventform

# Endpoint-secret encryption: base64-encoded 32-byte AES-256 key (in-process AES-256-GCM).
# Leave unset in dev (a fixed dev-only key is used); REQUIRED in prod.
# SECRET_ENC_KEY=

# pipeline / worker
KAFKA_BROKERS=localhost:29092
CONNECT_URL=http://localhost:8083
WORKER_PORT=3002
WEBHOOK_TIMEOUT_MS=10000
RETRY_POLL_MS=5000
OUTBOX_RETENTION_HOURS=24

# api
PORT=3001
AUTH_MODE=dev
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=120
# PUBLIC_SUBMIT_THROTTLE_LIMIT=10

# production auth (required when AUTH_MODE=cognito)
# COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<poolId>
# COGNITO_CLIENT_ID=
TRUST_PROXY=0
