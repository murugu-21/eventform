# Local dev needs NO database credentials: the dev Postgres uses trust auth and
# the app defaults to password-less localhost connections. Just `pnpm db:up`.
# This file is a template — copy to .env and fill in only what you override.
# NEVER commit real passwords here.

# ─── Database (override only to point at a remote DB, e.g. Neon) ─────────────
# DATABASE_URL=postgres://<owner>:<password>@<host>/<db>?sslmode=require               # admin/owner: migrations, Debezium CDC
# DATABASE_URL_API=postgres://app_api:<password>@<host>/<db>?sslmode=require           # API role (RLS-enforced)
# DATABASE_URL_WORKER=postgres://app_worker:<password>@<host>/<db>?sslmode=require      # worker role (BYPASSRLS)

# ─── Production secrets (set in prod env / SSM — never commit real values) ───
# APP_API_PASSWORD=          # app_api role password — applied by `pnpm db:roles` / bootstrap.sh
# APP_WORKER_PASSWORD=       # app_worker role password
# SECRET_ENC_KEY=            # base64 32-byte AES-256 key:  head -c 32 /dev/urandom | base64
# COGNITO_ISSUER=
# COGNITO_CLIENT_ID=
# TUNNEL_TOKEN=

# ─── Non-secret tunables (optional; defaults shown) ──────────────────────────
# PORT=3001
# WORKER_PORT=3002
# AUTH_MODE=dev
# KAFKA_BROKERS=localhost:29092
# WEBHOOK_TIMEOUT_MS=10000
# RETRY_POLL_MS=5000
# OUTBOX_RETENTION_HOURS=24
