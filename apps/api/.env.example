# API server port
PORT=3001

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Database connection URLs
DATABASE_URL_API=postgres://app_api:app_api_dev@localhost:5432/eventform
DATABASE_URL=postgres://eventform:eventform@localhost:5432/eventform

# Authentication mode: "dev" uses Bearer dev_<sub> tokens; "cognito" validates Cognito JWTs
AUTH_MODE=dev

# Endpoint-secret encryption: base64-encoded 32-byte AES-256 key (AES-256-GCM, in-process).
# Leave unset in dev (a fixed dev-only key is used). REQUIRED in production:
#   SECRET_ENC_KEY=$(head -c 32 /dev/urandom | base64)
# SECRET_ENC_KEY=

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
PUBLIC_SUBMIT_THROTTLE_LIMIT=10
