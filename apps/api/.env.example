# API env template — copy to .env and override as needed. Local dev needs no DB
# credentials (dev Postgres uses trust auth). NEVER commit real passwords.

# API server port
PORT=3001

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Database (override only for a remote DB; local dev defaults to password-less localhost)
# DATABASE_URL_API=postgres://app_api:<password>@<host>/<db>?sslmode=require
# DATABASE_URL=postgres://<owner>:<password>@<host>/<db>?sslmode=require

# Authentication mode: "dev" uses Bearer dev_<sub> tokens; "cognito" validates Cognito JWTs
AUTH_MODE=dev

# Endpoint-secret encryption: base64-encoded 32-byte AES-256 key (AES-256-GCM, in-process).
# Leave unset in dev (a fixed dev-only key is used). REQUIRED in production:
#   SECRET_ENC_KEY=$(head -c 32 /dev/urandom | base64)
# SECRET_ENC_KEY=

# Rate limiting
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
PUBLIC_SUBMIT_THROTTLE_LIMIT=10
