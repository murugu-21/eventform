VITE_API_URL=http://localhost:3001
VITE_AUTH_MODE=dev

# Cognito settings (required when VITE_AUTH_MODE=cognito)
VITE_COGNITO_DOMAIN=
VITE_COGNITO_CLIENT_ID=
VITE_REDIRECT_URI=

# Scale-to-zero wake endpoint (the ComputeStack WakeUrl output). Set in the
# Cloudflare Pages env so the health gate can start the box; leave blank in dev.
VITE_WAKE_URL=
